{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data for authenticated Pennywise account.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    },
    "TransactionItem": {
      "title": "TransactionItem",
      "description": "Individual transaction entry (expense or income) synced to cloud.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["EXPENSE", "INCOME"] },
        "category": { "type": "string" },
        "date": { "type": "integer" },
        "paymentMethod": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "type", "category", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "TransactionItem",
      "description": "User's financial transactions subcollection."
    }
  }
}
